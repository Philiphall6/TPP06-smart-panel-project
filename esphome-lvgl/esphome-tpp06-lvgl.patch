@@ -0,0 +1,32 @@
+import esphome.codegen as cg
+from esphome.components import touchscreen
+import esphome.config_validation as cv
+from esphome.const import CONF_ID, PLATFORM_HOST
+from esphome.types import ConfigType
+
+CODEOWNERS = ["@Philiphall6"]
+DEPENDENCIES = ["host"]
+
+CONF_DEVICE = "device"
+
+evdev_ns = cg.esphome_ns.namespace("evdev")
+EvdevTouchscreen = evdev_ns.class_("EvdevTouchscreen", touchscreen.Touchscreen)
+
+CONFIG_SCHEMA = cv.All(
+    touchscreen.touchscreen_schema(
+        "40ms",
+        defaults={"x_min": 0, "x_max": 320, "y_min": 0, "y_max": 480},
+    ).extend(
+        {
+            cv.GenerateID(): cv.declare_id(EvdevTouchscreen),
+            cv.Optional(CONF_DEVICE, default="/dev/input/event1"): cv.string_strict,
+        }
+    ),
+    cv.only_on(PLATFORM_HOST),
+)
+
+
+async def to_code(config: ConfigType) -> None:
+    var = cg.new_Pvariable(config[CONF_ID])
+    cg.add(var.set_device(config[CONF_DEVICE]))
+    await touchscreen.register_touchscreen(var, config)
diff --git a/esphome/components/evdev/touchscreen/evdev_touchscreen.cpp b/esphome/components/evdev/touchscreen/evdev_touchscreen.cpp
new file mode 100644
index 0000000..63276be
--- /dev/null
+++ b/esphome/components/evdev/touchscreen/evdev_touchscreen.cpp
@@ -0,0 +1,73 @@
+#include "evdev_touchscreen.h"
+
+#ifdef USE_HOST
+
+#include <cerrno>
+#include <cstring>
+#include <fcntl.h>
+#include <linux/input.h>
+#include <unistd.h>
+
+#include "esphome/core/log.h"
+
+namespace esphome::evdev {
+
+static const char *const TAG = "evdev.touchscreen";
+
+// Kernel 4.4 on the 32-bit TPP06 always sends a 16-byte input_event. Defining
+// the wire layout explicitly avoids a time_t-size mismatch with modern uClibc.
+struct InputEvent32 {
+  int32_t seconds;
+  int32_t microseconds;
+  uint16_t type;
+  uint16_t code;
+  int32_t value;
+};
+
+void EvdevTouchscreen::setup() {
+  this->fd_ = open(this->device_.c_str(), O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+  if (this->fd_ < 0) {
+    ESP_LOGE(TAG, "Cannot open %s: %s", this->device_.c_str(), std::strerror(errno));
+    this->mark_failed();
+    return;
+  }
+  ESP_LOGI(TAG, "Reading Goodix events from %s", this->device_.c_str());
+}
+
+void EvdevTouchscreen::dump_config() {
+  ESP_LOGCONFIG(TAG, "Linux evdev touchscreen:");
+  ESP_LOGCONFIG(TAG, "  Device: %s", this->device_.c_str());
+}
+
+void EvdevTouchscreen::on_shutdown() {
+  if (this->fd_ >= 0) {
+    close(this->fd_);
+    this->fd_ = -1;
+  }
+}
+
+void EvdevTouchscreen::update_touches() {
+  if (this->fd_ < 0)
+    return;
+
+  InputEvent32 event{};
+  while (read(this->fd_, &event, sizeof(event)) == sizeof(event)) {
+    if (event.type != EV_ABS)
+      continue;
+    if (event.code == ABS_MT_SLOT) {
+      this->slot_ = event.value;
+    } else if (this->slot_ == 0 && event.code == ABS_MT_POSITION_X) {
+      this->x_ = event.value;
+    } else if (this->slot_ == 0 && event.code == ABS_MT_POSITION_Y) {
+      this->y_ = event.value;
+    } else if (this->slot_ == 0 && event.code == ABS_MT_TRACKING_ID) {
+      this->pressed_ = event.value >= 0;
+    }
+  }
+  if (this->pressed_)
+    this->add_raw_touch_position_(0, this->x_, this->y_);
+}
+
+}  // namespace esphome::evdev
+
+#endif
diff --git a/esphome/components/evdev/touchscreen/evdev_touchscreen.h b/esphome/components/evdev/touchscreen/evdev_touchscreen.h
new file mode 100644
index 0000000..ae75385
--- /dev/null
+++ b/esphome/components/evdev/touchscreen/evdev_touchscreen.h
@@ -0,0 +1,32 @@
+#pragma once
+
+#ifdef USE_HOST
+
+#include <cstdint>
+#include <string>
+
+#include "esphome/components/touchscreen/touchscreen.h"
+
+namespace esphome::evdev {
+
+class EvdevTouchscreen final : public touchscreen::Touchscreen {
+ public:
+  void setup() override;
+  void dump_config() override;
+  void on_shutdown() override;
+  void set_device(const std::string &device) { this->device_ = device; }
+
+ protected:
+  void update_touches() override;
+
+  std::string device_{"/dev/input/event1"};
+  int fd_{-1};
+  int32_t x_{0};
+  int32_t y_{0};
+  int32_t slot_{0};
+  bool pressed_{false};
+};
+
+}  // namespace esphome::evdev
+
+#endif
