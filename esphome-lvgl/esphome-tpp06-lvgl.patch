diff --git a/tpp06/README.md b/tpp06/README.md
new file mode 100644
index 0000000..b9ea26b
--- /dev/null
+++ b/tpp06/README.md
@@ -0,0 +1,32 @@
+# TPP06 native ESPHome + LVGL experiment
+
+This directory builds ESPHome's `host` platform as a static ARMv5 binary for
+the MOES/Tuya TPP06 (Anyka AK3761E). It adds two Linux-native ESPHome drivers:
+
+- `fbdev`: `/dev/fb0`, 320x480, RGB565/BGR565 detection;
+- `evdev`: `/dev/input/event1`, Goodix multitouch events.
+
+The example `lvgl.yaml` renders a colour test and a touch button with ESPHome's
+normal LVGL component. It does not install anything on the panel at boot.
+
+## Build
+
+Use the official Bootlin ARMv5 EABI/uClibc stable 2026.08-1 toolchain (GCC
+15.3 or newer is required by ESPHome's C++20 build):
+
+```sh
+export TPP06_TOOLCHAIN_PREFIX=/opt/armv5-eabi--uclibc--stable-2026.08-1/bin/arm-linux
+export ESPHOME_PYTHON=/path/to/esphome-venv/bin/python
+./tpp06/build.sh
+```
+
+The result is written to:
+
+```text
+tpp06/.esphome/build/tpp06-lvgl/.pioenvs/tpp06-lvgl/program
+```
+
+It is a static ARM EABI5, soft-float executable. Test it from `/tmp` before
+creating any persistent startup service. Stop Tuya's UI only for the duration
+of a supervised test because both programs need exclusive framebuffer and
+touchscreen access.
diff --git a/tpp06/build.sh b/tpp06/build.sh
new file mode 100755
index 0000000..6fc3bb1
--- /dev/null
+++ b/tpp06/build.sh
@@ -0,0 +1,29 @@
+#!/bin/sh
+set -eu
+
+repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+toolchain_prefix=${TPP06_TOOLCHAIN_PREFIX:-}
+python_bin=${ESPHOME_PYTHON:-python3}
+
+if [ -z "$toolchain_prefix" ]; then
+  echo "Set TPP06_TOOLCHAIN_PREFIX to the ARMv5 uClibc toolchain prefix." >&2
+  echo "Example: /opt/armv5-eabi--uclibc--stable-2026.08-1/bin/arm-linux" >&2
+  exit 2
+fi
+
+for tool in gcc g++ ar objdump readelf; do
+  if [ ! -x "${toolchain_prefix}-${tool}" ]; then
+    echo "Missing compiler tool: ${toolchain_prefix}-${tool}" >&2
+    exit 2
+  fi
+done
+
+export CC="${toolchain_prefix}-gcc"
+export CXX="${toolchain_prefix}-g++"
+export AR="${toolchain_prefix}-ar"
+export OBJDUMP="${toolchain_prefix}-objdump"
+export READELF="${toolchain_prefix}-readelf"
+export ESPHOME_PCH_ENABLE=0
+
+cd "$repo_dir"
+exec "$python_bin" -m esphome compile tpp06/lvgl.yaml
diff --git a/tpp06/lvgl.yaml b/tpp06/lvgl.yaml
new file mode 100644
index 0000000..ffb9684
--- /dev/null
+++ b/tpp06/lvgl.yaml
@@ -0,0 +1,96 @@
+esphome:
+  name: tpp06-lvgl
+  friendly_name: TPP06 ESPHome LVGL
+  build_flags:
+    - -static
+    - -march=armv5te
+    - -marm
+    - -mfloat-abi=soft
+
+host:
+  mac_address: "02:00:00:00:06:01"
+
+logger:
+  level: INFO
+
+display:
+  - platform: fbdev
+    id: tpp06_display
+    device: /dev/fb0
+    dimensions:
+      width: 320
+      height: 480
+    auto_clear_enabled: false
+    update_interval: never
+
+touchscreen:
+  - platform: evdev
+    id: tpp06_touch
+    display: tpp06_display
+    device: /dev/input/event1
+    update_interval: 20ms
+    calibration:
+      x_min: 0
+      x_max: 320
+      y_min: 0
+      y_max: 480
+
+lvgl:
+  displays: tpp06_display
+  touchscreens:
+    - touchscreen_id: tpp06_touch
+  buffer_size: 25%
