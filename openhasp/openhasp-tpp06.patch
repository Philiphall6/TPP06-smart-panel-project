diff --git a/tpp06/platformio_cross.py b/tpp06/platformio_cross.py
new file mode 100644
index 0000000..25d12bf
--- /dev/null
+++ b/tpp06/platformio_cross.py
@@ -0,0 +1,29 @@
+import os
+
+Import("env")
+
+toolchain = os.environ.get(
+    "TPP06_TOOLCHAIN_DIR",
+    "/opt/toolchains/armv5-eabi--uclibc--stable-2018.02-2",
+)
+prefix = os.path.join(toolchain, "bin", "arm-linux-")
+wrapper_dir = os.path.join(env.subst("$PROJECT_DIR"), "tpp06", "cross-bin")
+
+# PlatformIO's native builder deliberately resets CC/CXX after extra scripts
+# have run. Put cross-tool aliases first in the command environment so the
+# builder's plain `gcc`, `g++`, and `ar` commands resolve to the ARM tools.
+env.PrependENVPath("PATH", wrapper_dir)
+
+env.Replace(
+    CC=prefix + "gcc",
+    CXX=prefix + "g++",
+    AR=prefix + "ar",
+    AS=prefix + "as",
+    RANLIB=prefix + "ranlib",
+    OBJCOPY=prefix + "objcopy",
+    STRIP=prefix + "strip",
+)
+env.Append(
+    CCFLAGS=["-march=armv5te", "-marm", "-mfloat-abi=soft"],
+    LINKFLAGS=["-static", "-march=armv5te", "-marm", "-mfloat-abi=soft"],
+)
diff --git a/tpp06/probe/tpp06_probe.c b/tpp06/probe/tpp06_probe.c
new file mode 100644
index 0000000..d8c0564
--- /dev/null
+++ b/tpp06/probe/tpp06_probe.c
@@ -0,0 +1,72 @@
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/fb.h>
+#include <linux/input.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+static void probe_framebuffer(const char *path)
+{
+    struct fb_fix_screeninfo fix;
+    struct fb_var_screeninfo var;
+    int fd = open(path, O_RDONLY);
+
+    if(fd < 0) {
+        fprintf(stderr, "%s: %s\n", path, strerror(errno));
+        return;
+    }
+    if(ioctl(fd, FBIOGET_FSCREENINFO, &fix) < 0 ||
+       ioctl(fd, FBIOGET_VSCREENINFO, &var) < 0) {
+        fprintf(stderr, "%s: framebuffer ioctl failed: %s\n", path, strerror(errno));
+        close(fd);
+        return;
+    }
+
+    printf("framebuffer=%s id=%s visible=%ux%u virtual=%ux%u bpp=%u stride=%u bytes=%u\n",
+           path, fix.id, var.xres, var.yres, var.xres_virtual, var.yres_virtual,
+           var.bits_per_pixel, fix.line_length, fix.smem_len);
+    printf("rgba r=%u/%u g=%u/%u b=%u/%u a=%u/%u rotate=%u\n",
+           var.red.offset, var.red.length, var.green.offset, var.green.length,
+           var.blue.offset, var.blue.length, var.transp.offset,
+           var.transp.length, var.rotate);
+    close(fd);
+}
+
+static void print_abs_axis(int fd, int axis, const char *label)
+{
+    struct input_absinfo abs;
+    if(ioctl(fd, EVIOCGABS(axis), &abs) == 0) {
+        printf(" %s=%d..%d", label, abs.minimum, abs.maximum);
+    }
+}
+
+static void probe_input(const char *path)
+{
+    char name[128] = {0};
+    int fd = open(path, O_RDONLY | O_NONBLOCK);
+
+    if(fd < 0) {
+        fprintf(stderr, "%s: %s\n", path, strerror(errno));
+        return;
+    }
+    if(ioctl(fd, EVIOCGNAME(sizeof(name)), name) < 0) {
+        snprintf(name, sizeof(name), "unknown");
+    }
+    printf("input=%s name=%s", path, name);
+    print_abs_axis(fd, ABS_X, "x");
+    print_abs_axis(fd, ABS_Y, "y");
+    print_abs_axis(fd, ABS_MT_POSITION_X, "mt_x");
+    print_abs_axis(fd, ABS_MT_POSITION_Y, "mt_y");
+    puts("");
+    close(fd);
+}
+
+int main(void)
+{
+    probe_framebuffer("/dev/fb0");
+    probe_input("/dev/input/event0");
+    probe_input("/dev/input/event1");
+    return 0;
+}
