index 0000000..5fa0661
--- /dev/null
+++ b/tpp06/tools/fb565_to_png.py
@@ -0,0 +1,42 @@
+#!/usr/bin/env python3
+"""Convert a TPP06 framebuffer dump (BGR565, little-endian) to PNG."""
+
+import argparse
+from pathlib import Path
+
+from PIL import Image
+
+
+def expand(value: int, bits: int) -> int:
+    maximum = (1 << bits) - 1
+    return (value * 255 + maximum // 2) // maximum
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("input", type=Path)
+    parser.add_argument("output", type=Path)
+    parser.add_argument("--width", type=int, default=320)
+    parser.add_argument("--height", type=int, default=480)
+    args = parser.parse_args()
+
+    raw = args.input.read_bytes()
+    expected = args.width * args.height * 2
+    if len(raw) != expected:
+        raise SystemExit(f"expected {expected} bytes, got {len(raw)}")
+
+    rgb = bytearray(args.width * args.height * 3)
+    for index in range(args.width * args.height):
+        pixel = raw[index * 2] | (raw[index * 2 + 1] << 8)
+        red = expand(pixel & 0x1F, 5)
+        green = expand((pixel >> 5) & 0x3F, 6)
+        blue = expand((pixel >> 11) & 0x1F, 5)
+        offset = index * 3
+        rgb[offset : offset + 3] = bytes((red, green, blue))
+
+    image = Image.frombytes("RGB", (args.width, args.height), bytes(rgb))
+    image.save(args.output)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tpp06/tools/tcp_receive.py b/tpp06/tools/tcp_receive.py
