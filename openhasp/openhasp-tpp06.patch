diff --git a/tpp06/patches/lv-drivers-tpp06-bgr565.patch b/tpp06/patches/lv-drivers-tpp06-bgr565.patch
new file mode 100644
index 0000000..9194ed4
--- /dev/null
+++ b/tpp06/patches/lv-drivers-tpp06-bgr565.patch
@@ -0,0 +1,25 @@
+diff --git a/display/fbdev.c b/display/fbdev.c
+index 04706ad..06438b7 100644
+--- a/display/fbdev.c
++++ b/display/fbdev.c
+@@ -206,7 +206,19 @@ void fbdev_flush(lv_disp_drv_t* drv, const lv_area_t* area, lv_color_t* color_p)
+         else if(vinfo.bits_per_pixel == 16) {
+             for(y = act_y1; y <= act_y2; y++) {
+                 location = (act_x1 + vinfo.xoffset) + (y + vinfo.yoffset) * finfo.line_length / 2;
+-                memcpy(&fbp16[location], (uint32_t*)color_p, (act_x2 - act_x1 + 1) * 2);
++                /* Some embedded framebuffers (including the TPP06) expose
++                 * BGR565: red starts at bit 0 and blue at bit 11. LVGL's
++                 * 16-bit buffer is RGB565, so exchange the two 5-bit fields
++                 * when the kernel-reported layout requires it. */
++                if(vinfo.red.offset == 0 && vinfo.blue.offset == 11) {
++                    for(x = 0; x < w; x++) {
++                        uint16_t pixel      = color_p[x].full;
++                        fbp16[location + x] = (uint16_t)(((pixel & 0x001FU) << 11) | (pixel & 0x07E0U) |
++                                                         ((pixel & 0xF800U) >> 11));
++                    }
++                } else {
++                    memcpy(&fbp16[location], (uint32_t*)color_p, (act_x2 - act_x1 + 1) * 2);
++                }
+                 color_p += w;
+             }
+         }
