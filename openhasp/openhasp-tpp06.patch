index 0000000..a8d91a0
--- /dev/null
+++ b/tpp06/tools/tcp_receive.py
@@ -0,0 +1,39 @@
+#!/usr/bin/env python3
+"""Receive one file over a trusted LAN TCP connection.
+
+This is used because the TPP06 BusyBox image contains netcat while the Mint
+host used for bring-up does not. It intentionally accepts one client and then
+exits.
+"""
+
+import argparse
+import socket
+from pathlib import Path
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("output", type=Path)
+    parser.add_argument("--bind", default="0.0.0.0")
+    parser.add_argument("--port", type=int, default=23462)
+    args = parser.parse_args()
+
+    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as server:
+        server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+        server.bind((args.bind, args.port))
+        server.listen(1)
+        connection, address = server.accept()
+        with connection, args.output.open("wb") as output:
+            total = 0
+            while True:
+                chunk = connection.recv(65536)
+                if not chunk:
+                    break
+                output.write(chunk)
+                total += len(chunk)
+
+    print(f"received {total} bytes from {address[0]} into {args.output}")
+
+
+if __name__ == "__main__":
+    main()
