@@ -0,0 +1,21 @@
+# TPP06 port status
+
+Validated on 2026-11-17 against a TPP06 running Tuya firmware 1.2.3:
+
+- static ARM EABI5 soft-float binary starts on the ARM926EJ-S;
+- Linux framebuffer detected at 320 x 480, 16 bpp, 640-byte stride;
+- BGR565 conversion validated with exact red, green, blue and white captures;
+- display orientation validated as portrait 320 x 480;
+- Goodix touchscreen detected on `/dev/input/event1`;
+- GPIO keys detected on `/dev/input/event0`;
+- LVGL and openHASP 0.7.2 start successfully;
+- the Goodix multitouch ranges are corrected to X=0..320 and Y=0..480;
+- Tuya remains installed and running; tests use `/tmp` only.
+
+Still to validate before persistent installation:
+
+- real touch press/release events and orientation;
+- MQTT authentication and Home Assistant discovery;
+- backlight control;
+- physical relay, button LED, buzzer and IR mappings;
+- watchdog and rollback path before replacing the Tuya startup process.
diff --git a/tpp06/build-openhasp.sh b/tpp06/build-openhasp.sh
new file mode 100755
index 0000000..b13c544
--- /dev/null
+++ b/tpp06/build-openhasp.sh
@@ -0,0 +1,41 @@
+#!/bin/sh
+set -eu
+
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+REPO_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
+PIO=${PIO:-}
+LV_DRIVERS_DIR="$REPO_DIR/.pio/libdeps/tpp06/lv_drivers"
+EVDEV_PATCH="$SCRIPT_DIR/patches/lv-drivers-tpp06-evdev.patch"
+BGR565_PATCH="$SCRIPT_DIR/patches/lv-drivers-tpp06-bgr565.patch"
+OUTPUT_DIR="$REPO_DIR/build-tpp06"
+TOOLCHAIN_DIR=${TPP06_TOOLCHAIN_DIR:-/opt/toolchains/armv5-eabi--uclibc--stable-2018.02-2}
+
+if [ -z "$PIO" ]; then
+    PIO=$(command -v pio 2>/dev/null || command -v platformio 2>/dev/null || true)
+fi
+if [ -z "$PIO" ]; then
+    echo "PlatformIO not found; set PIO=/path/to/pio" >&2
+    exit 1
+fi
+
+cd "$REPO_DIR"
+"$PIO" pkg install -e tpp06
+
+for patch in "$EVDEV_PATCH" "$BGR565_PATCH"; do
+    if git -C "$LV_DRIVERS_DIR" apply --check "$patch" 2>/dev/null; then
+        git -C "$LV_DRIVERS_DIR" apply "$patch"
+    elif git -C "$LV_DRIVERS_DIR" apply --reverse --check "$patch" 2>/dev/null; then
+        : # Patch is already present.
+    else
+        echo "lv_drivers does not match the expected source revision for $patch" >&2
+        exit 1
+    fi
+done
+
+"$PIO" run -e tpp06
+mkdir -p "$OUTPUT_DIR"
+cp "$REPO_DIR/.pio/build/tpp06/program" "$OUTPUT_DIR/openhasp-tpp06"
+"$TOOLCHAIN_DIR/bin/arm-linux-strip" "$OUTPUT_DIR/openhasp-tpp06"
+"$TOOLCHAIN_DIR/bin/arm-linux-readelf" -h "$OUTPUT_DIR/openhasp-tpp06" | \
+    grep -E 'Class:|Data:|Machine:|Flags:'
+ls -lh "$OUTPUT_DIR/openhasp-tpp06"
diff --git a/tpp06/build-probe.sh b/tpp06/build-probe.sh
new file mode 100755
index 0000000..4748741
--- /dev/null
+++ b/tpp06/build-probe.sh
@@ -0,0 +1,17 @@
+#!/bin/sh
+set -eu
+
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+REPO_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
+TOOLCHAIN_DIR=${TPP06_TOOLCHAIN_DIR:-/opt/toolchains/armv5-eabi--uclibc--stable-2018.02-2}
+CC="$TOOLCHAIN_DIR/bin/arm-linux-gcc"
+OUTPUT_DIR="$REPO_DIR/build-tpp06"
+
+mkdir -p "$OUTPUT_DIR"
+"$CC" -Os -static -march=armv5te -marm \
+    -Wall -Wextra -Werror \
+    "$SCRIPT_DIR/probe/tpp06_probe.c" \
+    -o "$OUTPUT_DIR/tpp06-probe"
+"$TOOLCHAIN_DIR/bin/arm-linux-strip" "$OUTPUT_DIR/tpp06-probe"
+"$TOOLCHAIN_DIR/bin/arm-linux-readelf" -h "$OUTPUT_DIR/tpp06-probe" | \
+    grep -E 'Class:|Data:|Machine:|Flags:'
